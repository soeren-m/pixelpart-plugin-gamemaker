{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "binaryDir": "build/${presetName}",
            "installDir": "pixelpart-plugin/extensions/Pixelpart",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PIXELPART_RUNTIME_MULTITHREADING": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-x64",
            "displayName": "Windows x64",
            "inherits": "windows-base"
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "build/${presetName}",
            "installDir": "pixelpart-plugin/extensions/Pixelpart",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PIXELPART_RUNTIME_MULTITHREADING": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x64",
            "inherits": "linux-base"
        },
        {
            "name": "macos-universal",
            "displayName": "macOS Universal",
            "generator": "Ninja",
            "binaryDir": "build/${presetName}",
            "installDir": "pixelpart-plugin/extensions/Pixelpart",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "PIXELPART_RUNTIME_MULTITHREADING": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ]
}
